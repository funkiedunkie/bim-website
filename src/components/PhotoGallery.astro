---
import { Image } from 'astro:assets'

interface Item {
  src: ImageMetadata
  alt: string
  /** Opt-in crop utility, e.g. object-pos-center — only when global top bias chops this shot. */
  imgClass?: string
}

interface Props {
  eyebrow?: string
  heading?: string
  items: Item[]
}

const { eyebrow = 'Inside Bodies in Motion', heading = 'More from this program', items } = Astro.props
---

{
  items.length > 0 && (
    <section class="section photo-gallery-section" aria-labelledby="photo-gallery-heading">
      <div class="section__inner">
        {eyebrow && <p class="section-eyebrow">{eyebrow}</p>}
        <h2 id="photo-gallery-heading" class="photo-gallery__heading">{heading}</h2>
        <ul class="photo-gallery">
          {items.map((item, i) => (
            <li class={`photo-gallery__item photo-gallery__item--${(i % 4) + 1}`}>
              <Image
                class:list={['photo-gallery__img', item.imgClass]}
                src={item.src}
                alt={item.alt}
                widths={[400, 640, 960]}
                sizes="(max-width:560px) 92vw, (max-width:900px) 48vw, (max-width:1100px) 33vw, 25vw"
                loading="lazy"
              />
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}
