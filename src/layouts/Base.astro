---
import '../styles/global.css'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'
import { absoluteUrl, SITE_URL } from '../lib/site'
import GoogleTagManager from '../components/GoogleTagManager.astro'

interface Props {
  title: string
  description: string
  /** Path of this page, e.g. "/preschool" ("/" for home). Used for the canonical URL. */
  path: string
  noindex?: boolean
  /** Override robots meta (e.g. "noindex,nofollow"). Defaults from noindex. */
  robots?: string
  jsonLd?: object[]
  /** Open Graph type, "article" for blog posts. */
  ogType?: string
  /** Absolute or site-root path for og:image / twitter:image. Defaults to the site icon. */
  ogImage?: string
  /** Optional alt text for the social share image. */
  ogImageAlt?: string
}

const { title, description, path, noindex = false, robots, jsonLd = [], ogType = 'website', ogImage, ogImageAlt } = Astro.props
const robotsContent = robots ?? (noindex ? 'noindex,follow' : 'index,follow')
const canonical = absoluteUrl(path)
const shareImage = ogImage
  ? ogImage.startsWith('http')
    ? ogImage
    : `${SITE_URL}${ogImage.startsWith('/') ? '' : '/'}${ogImage}`
  : `${SITE_URL}/icon-512.png`
const shareAlt = ogImageAlt ?? title
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robotsContent} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#fffaf0" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Bodies in Motion" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:alt" content={shareAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />
    <meta name="twitter:image:alt" content={shareAlt} />

    <link rel="preload" href="/fonts/bricolage.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="view-transition" content="same-origin" />

    {jsonLd.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
    <GoogleTagManager placement="head" />
  </head>
  <body>
    <GoogleTagManager placement="body" />
    <a class="skip-link" href="#main">Skip to main content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
