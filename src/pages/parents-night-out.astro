---
import ActivityPage from '../layouts/ActivityPage.astro'
import { LINKS, eventSchema, type FaqItem } from '../lib/site'
import heroImg from '../assets/photos/open-play-web_1.jpg'
import ProofPhotos from '../components/ProofPhotos.astro'
import photoHeroesNinjas from '../assets/photos/heroes-ninjas-pno.jpg'

const title = 'Parents’ Night Out in Boise, ID | Bodies in Motion'
const description =
  'Parents’ Night Out at Bodies in Motion in Boise, ID: drop the kids off for a fun-filled evening. Heroes & Ninjas (Nov 14) and Family Night Out.'

// Nov 14, 2026 Heroes & Ninjas (Rhea 2026-10-27). After the cutoff below the build drops the
// Event schema and shows "next date to be announced", so rebuild/update this page once the date passes.
// Boise is on MST (UTC-7) after the first Sunday of November.
const heroesStart = '2026-11-14T17:00:00-07:00'
const heroesEnd = '2026-11-14T21:00:00-07:00'
const heroesUpcoming = Date.now() < Date.parse(heroesEnd)

// Standing PNO product (Cosmic Glow / Ahoy Adventures on CFK): $51, 20% sibling = $40.80, ages 5–12, 5–9 PM, dinner included.
// Rhea’s email confirmed theme + date only; TODO(Duncan/Rhea): confirm price/ages once Heroes & Ninjas is listed on CFK,
// and update LINKS.pnoRegister to the specific CFK session URL.
const heroesFacts =
  'Heroes & Ninjas – Parents’ Night Out is a themed evening for ages 5–12, 5:00–9:00 PM, at $51 per child, with a 20% sibling discount ($40.80 for additional siblings) and dinner included. Kids dress as heroes or ninjas for a fun-filled night while parents get a kidless evening.'

const faq: FaqItem[] = [
  {
    q: 'What is Parents’ Night Out?',
    a: 'Parents’ Night Out is an opportunity for you and the sweetness in your life to enjoy a kidless evening. Drop the kids off at Bodies in Motion and we’ll treat them to a fun-filled night.',
  },
  {
    q: 'What is Heroes & Ninjas?',
    a: heroesFacts,
  },
  heroesUpcoming
    ? {
        q: 'When is the next Parents’ Night Out?',
        a: 'Heroes & Ninjas is on Saturday, November 14, 2026 from 5:00 to 9:00 PM. Register through Camps for Kids Idaho or call (208) 381-0587.',
      }
    : {
        q: 'When is the next Parents’ Night Out?',
        a: 'Call (208) 381-0587 or use the registration link on this page to find out about the next Parents’ Night Out.',
      },
  {
    q: 'What ages is Parents’ Night Out for?',
    a: 'Heroes & Ninjas is for ages 5–12. Family Night Out is for ages 3 (potty trained) up to adults.',
  },
  {
    q: 'What is Family Night Out?',
    a: 'Family Night Out is an evening designed for families to laugh, play and create memories together, from 5 to 9 PM, for ages 3 (and potty trained) to adults. It costs $49 per person, with additional family members $39.20 each. The next date is coming soon and spaces are limited.',
  },
  {
    q: 'Is dinner included?',
    a: 'Yes. Heroes & Ninjas includes dinner in the price.',
  },
  {
    q: 'How do I register?',
    a: 'Register for Heroes & Ninjas through Camps for Kids Idaho using the registration link on this page, or call (208) 381-0587.',
  },
]

const reviews = [
  { quote: 'Took my son there for super hero night. It was his first time there. I was nervous, but they made me feel better by making him feel included. He had a blast, and didn’t want to leave. We will be back!', name: 'Lisa R.', source: '5 stars, Facebook' },
  { quote: 'Parent’s night out is a blessing.', name: 'Anonymous', source: '5 stars, Google' },
  { quote: 'Been going for years and love the family atmosphere! Great workouts! Kick butt parents nights out! Great play area!', name: 'Susan L.', source: '5 stars, Facebook' },
]

const extraJsonLd = heroesUpcoming
  ? [
      eventSchema({
        name: 'Heroes & Ninjas – Parents’ Night Out',
        description: heroesFacts,
        startDate: heroesStart,
        endDate: heroesEnd,
        url: LINKS.pnoRegister,
        price: '51',
        typicalAgeRange: '5-12',
      }),
    ]
  : []

const proofHeroes = [
  {
    src: photoHeroesNinjas,
    alt: 'Cartoon kids dressed as superheroes and ninjas celebrating together on a city rooftop',
    caption: 'Heroes & Ninjas: dress up and play while you get a night out.',
  },
]
---

<ActivityPage
  title={title}
  description={description}
  path="/parents-night-out"
  eyebrow="Kidless evenings for parents"
  h1="Parents’ Night Out in Boise"
  lead="Drop the kids off at Bodies in Motion and we’ll treat them to a fun-filled night."
  heroImg={heroImg}
  heroAlt="Kids racing down orange and blue indoor slides"
  ctaUrl={LINKS.pnoRegister}
  ctaLabel="Register for Heroes & Ninjas"
  ctaHeading="Ready for a kidless evening?"
  ctaText="Register through Camps for Kids Idaho, or call us at (208) 381-0587."
  faq={faq}
  reviews={reviews}
  extraJsonLd={extraJsonLd}
>
  <section class="section">
    <div class="section__inner prose">
      <h2>A kidless evening for you, a fun night for them</h2>
      <p>
        Parents’ Night Out is an opportunity for you and the sweetness in your life to enjoy a kidless evening. Drop the
        kids off at Bodies in Motion and we’ll treat them to a fun-filled night. Families come to us from Boise,
        Meridian and Garden City.
      </p>

      <div class="two-col care-claim">
        <div class="care-claim__text">
            <h2>Heroes &amp; Ninjas – Parents’ Night Out</h2>
          <p>
            Capes, masks and ninja moves! Kids dress as heroes or ninjas for a themed evening of play, games, pizza and a
            sweet treat while you enjoy a kidless night out.
          </p>
          <ul class="bullets">
            {heroesUpcoming
              ? <li><strong>Date:</strong> Saturday, November 14, 2026</li>
              : <li><strong>Date:</strong> the next date is to be announced. Call us or check the registration link.</li>}
            <li><strong>Time:</strong> 5:00–9:00 PM</li>
            <li><strong>For:</strong> ages 5–12</li>
            <li><strong>Cost:</strong> $51 per child; 20% sibling discount ($40.80 per additional sibling); dinner included</li>
          </ul>
          <div class="stub-actions">
            <a class="btn-primary" href={LINKS.pnoRegister} target="_blank" rel="noopener noreferrer">Register for Heroes &amp; Ninjas</a>
          </div>
        </div>
        <ProofPhotos items={proofHeroes} />
      </div>

      <h2>Family Night Out</h2>
      <p>
        A new twist on family fun: an evening designed for families to laugh, play and create memories together. Spaces
        are limited.
      </p>
      <ul class="bullets">
        <li><strong>Date:</strong> next date coming soon</li>
        <li><strong>Time:</strong> 5–9 PM</li>
        <li><strong>For:</strong> ages 3 (and potty trained) to adults</li>
        <li><strong>Cost:</strong> $49 per person, additional family members $39.20 each</li>
      </ul>
      <p>
        Where else can you see your dad attempt to dance in silence or your family build a cookie masterpiece
        blindfolded? Questions? Call <a href="tel:+12083810587">(208) 381-0587</a>.
      </p>
    </div>
  </section>
</ActivityPage>
