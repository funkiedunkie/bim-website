---
import { Image, getImage } from 'astro:assets'
import Base from '../layouts/Base.astro'
import Faq from '../components/Faq.astro'
import Location from '../components/Location.astro'
import { NAP, LINKS, LICENSE_NUMBER, SITE_URL, CHILDCARE_OPENING_HOURS, childCareSchema, faqSchema, type FaqItem } from '../lib/site'
import ninjaImg from '../assets/photos/web-summer-camp-ninja-warrior_orig.jpg'
import ropesImg from '../assets/photos/super-birthday-ropes-web_1_orig.jpg'
import zoeyImg from '../assets/photos/zoey-toddler-2.jpeg'
import preschoolImg from '../assets/photos/preschool-web_orig.jpg'
import afterSchoolImg from '../assets/photos/after-school-pals.jpg'
import campImg from '../assets/photos/camps-web_orig.jpg'
import salmonImg from '../assets/photos/ninja-salmon_orig.jpg'
import bdayImg from '../assets/photos/birthday-party-web.jpeg'
import slideImg from '../assets/photos/open-play-web_1.jpg'
import ropesCourseImg from '../assets/photos/ropes-course-web.jpeg'
import values1Img from '../assets/values1.jpg'
import values2Img from '../assets/values2.jpg'
import values3Img from '../assets/values3.jpg'
import '../styles/home.css'

const title = 'Bodies in Motion | Childcare, Preschool & Activities in Boise, ID'
const description =
  'Serving Boise since 2011: infant & toddler care, preschool, before & after school care, camps, ninja warrior, open play and more at 729 W. Diamond St.'

const tickerItems = [
  'Before & After School Care',
  'Ninja Warrior',
  'Fitness',
  'Pickleball',
  'Camps',
  'Indoor Playground',
  'Ropes Course',
  'Birthday Parties',
  'Preschool',
  'Infant & Toddler Care',
  'Flatbread Cafe & Espresso Bar',
]

// "Find the right program" cards (from concept D). Every value is already published on the program pages.
// TODO(Duncan): show "from $X" tuition or not. SHOW_PRICES=false swaps to "Pricing shared on your tour".
// TODO(Duncan/Rhea): real Open / Limited / Waitlist status per program; until then "Ask about openings" links to /contact with program prefilled (not a fake status).
const SHOW_PRICES = true
const programs = [
  { name: 'Infant & Toddler', ages: '6 weeks – 3 years', hours: 'Mon–Fri · 7:30 am – 6 pm', fact: '1 teacher for every 4 babies', from: '$650/mo', fromNote: 'part time, 2 days', img: zoeyImg, alt: 'A teacher hugging a smiling toddler', to: '/infant-toddler-care', tour: LINKS.calendlyInfant, contactProgram: 'Infant & Toddler Care', color: 'var(--o)' },
  { name: 'Preschool', ages: 'Ages 3 – 6', hours: 'Morning class 9 am – 12 pm, or care 7:30 am – 6 pm', fact: '8:1 ratio · kindergarten readiness', from: '$355/mo', fromNote: 'morning class, 2 days', img: preschoolImg, alt: 'A laughing preschooler in a red cap', to: '/preschool', tour: LINKS.calendly30, contactProgram: 'Preschool', color: 'var(--bl)' },
  { name: 'Before & After School', ages: 'K – 6th grade', hours: 'From 7:30 am until school · pickup until 6 pm', fact: 'Transportation, snack, homework club', from: '$248/mo', fromNote: 'before school, 2 days', img: afterSchoolImg, alt: 'Two school-age boys in silly glasses', to: '/after-school-care', tour: LINKS.calendly30, contactProgram: 'Before & After School Care', color: 'var(--lime)' },
]

// Descriptions taken from the live Weebly site (home, program pages, meta descriptions).
const tiles = [
  { name: 'Camps', blurb: 'Summer camps and holiday camps', to: '/camps', img: campImg, alt: 'A camp counselor and kids giving thumbs up outdoors', color: 'var(--y)' },
  { name: 'Ninja Warrior', blurb: 'Classes for ages 5–13 plus open gym', to: '/ninja-warrior', img: salmonImg, alt: 'A child swinging across a ninja warrior obstacle', color: 'var(--o)' },
  { name: 'Birthday Parties', blurb: 'Themed parties, super parties and adult parties', to: '/birthday-parties', img: bdayImg, alt: 'Two girls smiling among pink and gold balloons', color: 'var(--bl)' },
  { name: 'Open Play', blurb: 'Indoor playground · fill out your waiver before you come', to: '/open-play', img: slideImg, alt: 'Kids racing down orange and blue indoor slides', color: 'var(--lime)' },
  { name: 'Ropes Course', blurb: 'A high aerial ropes adventure', to: '/ropes-course', img: ropesCourseImg, alt: 'Adults in harnesses on the indoor high ropes course', color: 'var(--lilac)' },
]
const more = [
  { name: 'Fitness classes', to: '/fitness-classes' },
  { name: 'Pickleball', to: '/pickleball' },
  { name: 'Parents’ Night Out', to: '/parents-night-out' },
  { name: 'Team building', to: '/team-building' },
]

const valueCards = [
  {
    label: 'Our Core Values',
    title: '7 Core Values',
    text: 'Commitment to Guests, Commitment to Work, Camaraderie, Always Learning & Knowing, Having Fun, Unique & Innovative, and Motion.',
    img: values1Img,
    alt: 'A counselor in a red shirt smiling with a camper outdoors',
  },
  {
    label: 'Our Purpose',
    title: 'Ignite activity. Encourage empowerment.',
    text: 'We are committed to igniting activity and encouraging empowerment.',
    img: values2Img,
    alt: 'Two Bodies in Motion staff in red shirts giving thumbs up in the gym',
  },
  {
    label: 'Our Promise',
    title: 'A “Wow” experience.',
    text: 'To provide a “Wow” experience through healthy activity that is empowering, fun, and engaging.',
    img: values3Img,
    alt: 'A smiling child in a red cap laughing in front of a wall of number cards',
  },
]

// Verbatim from the live Weebly home page (publication approved by Duncan, 2026-10-21).
const testimonials = [
  { quote: 'Bodies in Motion has figured out how to make fitness fun for all abilities, ages and interests. My kids love this place and so do I.', name: 'Katy F.' },
  { quote: 'Completed the ropes course last night. Had an absolutely phenomenal time and the staff was helpful, kind, and simply superb. Thanks for the great adventure!', name: 'Julie G.' },
  { quote: 'My kids just started TaeKwonDo here and they are loving it!', name: 'Valorie L.' },
]

const faq: FaqItem[] = [
  {
    q: 'Where is Bodies in Motion located?',
    a: 'Bodies in Motion is at 729 W. Diamond St., Boise, ID 83705, near the Fred Meyer on Federal Way. Boise is our only location. You can reach us at (208) 381-0587.',
  },
  {
    q: 'How long has Bodies in Motion been serving Boise?',
    a: 'Bodies in Motion has been serving Boise since 2011. Our founders closed their martial art school and re-opened it as Bodies in Motion in January 2011.',
  },
  {
    q: 'What does Bodies in Motion offer?',
    a: 'We offer infant & toddler care, preschool, before & after school care, camps, ninja warrior classes, fitness classes, pickleball, a ropes course, an indoor playground (open play), birthday parties, parents’ night out and team building, plus a Flatbread Cafe & Espresso Bar.',
  },
  {
    q: 'What childcare and school programs do you offer?',
    a: 'Infant & toddler care for ages 6 weeks to 36 months, preschool for ages 3–6, after school care for kindergarten through 6th grade, and before school care for 1st through 6th grade.',
  },
  {
    q: 'What are your childcare hours?',
    a: 'Full-time infant & toddler care and Preschool & Care are Monday through Friday, 7:30 am to 6:00 pm.',
  },
  {
    q: 'Can I fill out my waiver online?',
    a: 'Yes. You can save time by filling out your waiver online on our waiver page before you visit.',
  },
]

const jsonLd = [
  childCareSchema({ description, openingHours: [...CHILDCARE_OPENING_HOURS] }),
  faqSchema(faq),
]
const homeOg = await getImage({ src: zoeyImg, width: 1200 })
const ogImage = SITE_URL + homeOg.src
const bubbleColors = ['var(--o)', 'var(--bl)', 'var(--lime)']
---

<Base title={title} description={description} path="/" jsonLd={jsonLd} ogImage={ogImage} ogImageAlt="A teacher hugging a smiling toddler at Bodies in Motion">
  <section class="hero">
    <h1><span>Boise childcare</span> <span class="l2">for kids who</span> <span>never <em>stop</em></span> <span>moving.</span></h1>
    <div class="hero__pics">
      <Image class="p1" src={ninjaImg} alt="Campers cheering on a friend hanging from a ninja warrior bar" widths={[480, 800]} sizes="(max-width:900px) 70vw, 34vw" loading="eager" fetchpriority="high" />
      <Image class="p2" src={ropesImg} alt="Kids in helmets smiling on the ropes course" widths={[320, 560]} sizes="(max-width:900px) 45vw, 20vw" loading="eager" />
      <span class="sticker s1">Since 2011</span>
      <span class="sticker s2">Idaho STARS provider</span>
    </div>
    <div class="hero__foot">
      <p>It’s a great day at Bodies in Motion! Childcare, preschool and after-school care, plus ninja, ropes, camps and parties. All under one roof at {NAP.street}.</p>
      <ul class="hero__facts" aria-label="Quick facts">
        <li><b>Ages</b> 6 weeks – 6th grade</li>
        <li><b>Childcare</b> Mon–Fri 7:30 am – 6 pm</li>
        <li><b>License</b> #{LICENSE_NUMBER}</li>
      </ul>
      <div class="ctas">
        <a class="btn-primary btn-lg" href={LINKS.calendly30} target="_blank" rel="noopener noreferrer">Book a tour</a>
        <a class="btn-outline btn-lg" href="#programs">Find a program</a>
      </div>
    </div>
  </section>

  <div class="marquee-wrap" aria-hidden="true">
    <div class="marquee">
      <div>{[0, 1].map(() => <span>{tickerItems.map((t) => <>{t} ✦ </>)}</span>)}</div>
    </div>
  </div>

  <section id="programs" class="block" aria-labelledby="prog-h">
    <p class="section-eyebrow">Childcare &amp; preschool</p>
    <h2 id="prog-h" class="big">Find the right program</h2>
    <p class="sub">Licensed childcare #{LICENSE_NUMBER}. Small ratios. A building made for moving.</p>
    <div class="prog__grid">
      {programs.map((p) => (
        <article class="prog reveal" style={`--c:${p.color}`}>
          <Image src={p.img} alt={p.alt} widths={[420, 680]} sizes="(max-width:900px) 100vw, 33vw" />
          <div class="prog__body">
            <a class="status" href={`/contact?program=${encodeURIComponent(p.contactProgram)}`}><span class="sdot" aria-hidden="true"></span>Ask about openings</a>
            <h3>{p.name}</h3>
            <dl class="tags">
              <div><dt>Ages</dt><dd>{p.ages}</dd></div>
              <div><dt>Hours</dt><dd>{p.hours}</dd></div>
              <div><dt>Good to know</dt><dd>{p.fact}</dd></div>
              <div><dt>Tuition</dt><dd>{SHOW_PRICES ? <><b>from {p.from}</b> <small>{p.fromNote}</small></> : 'Pricing shared on your tour'}</dd></div>
            </dl>
            <div class="prog__cta">
              <a href={p.tour} target="_blank" rel="noopener noreferrer">Book a tour</a>
              <a href={p.to} aria-label={`Details about ${p.name}`}>Details →</a>
            </div>
          </div>
        </article>
      ))}
    </div>
    <p class="note">Openings change month to month. <a href="/contact">Ask us</a> what’s available for your child’s age.</p>
  </section>

  <section class="block" aria-labelledby="play-h">
    <h2 id="play-h" class="big">After school, weekends &amp; every&nbsp;birthday.</h2>
    <div class="tiles">
      {tiles.map((t, i) => (
        <a class={`tile tile--${i}`} href={t.to} style={`--c:${t.color}`}>
          <Image src={t.img} alt={t.alt} widths={[400, 720]} sizes="(max-width:900px) 90vw, 33vw" />
          <span class="tile__label"><b>{t.name}</b><small>{t.blurb}</small></span>
        </a>
      ))}
      <div class="tile tile--more">
        <b>Also here</b>
        <ul>{more.map((m) => <li><a href={m.to}>{m.name} →</a></li>)}</ul>
      </div>
    </div>
  </section>

  <section class="block mission" aria-labelledby="who-h">
    <p class="section-eyebrow">About Bodies in Motion</p>
    <h2 id="who-h" class="big">Our purpose, values and promise.</h2>
    <div class="mission__text">
      <p>At Bodies In Motion, we strive daily to be the ultimate multi-faceted facility in Boise that promotes longevity, vibrancy, health, fitness, and character through the art of motion.</p>
      <p>We offer kids and adults a wide range of unique and exciting programs that are perfect for anything from casual fun to serious gains. We work hard to maintain a family friendly atmosphere where members of the community feel welcomed to walk in the door and we can’t wait to see you soon!</p>
      <p>Families come to us from Boise, Meridian and Garden City.</p>
    </div>
    <div class="values__grid">
      {valueCards.map((v, i) => (
        <article class="value reveal" style={`--c:${['var(--y)', 'var(--lilac)', 'var(--bl)'][i]}`}>
          <Image src={v.img} alt={v.alt} widths={[400, 640]} sizes="(max-width:900px) 90vw, 30vw" loading="lazy" />
          <div class="value__body">
            <span class="tag">{v.label}</span>
            <h3>{v.title}</h3>
            <p>{v.text}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="block" aria-labelledby="love-h">
    <h2 id="love-h" class="big">Parents say it best</h2>
    <div class="love__row">
      {testimonials.map((t, i) => (
        <figure class="bubble reveal" style={`--c:${bubbleColors[i % 3]}`}>
          <blockquote>“{t.quote}”</blockquote>
          <figcaption>{t.name}</figcaption>
        </figure>
      ))}
    </div>
    <p class="note"><a href="/reviews">Read more reviews →</a></p>
  </section>

  <section class="section">
    <div class="section__inner"><Faq items={faq} /></div>
  </section>

  <section class="section section--surface">
    <div class="section__inner"><Location /></div>
  </section>

  <section class="bigcta">
    <h2>Come play.<br />Come see.</h2>
    <p>Book a tour for childcare, or call us at {NAP.phoneDisplay}. Coming for open play? <a href="/waiver">Sign a waiver</a> online first.</p>
    <div class="ctas">
      <a class="btn-primary btn-lg" href={LINKS.calendly30} target="_blank" rel="noopener noreferrer">Book a tour</a>
      <a class="btn-outline btn-lg" href="#programs">Find a program</a>
    </div>
  </section>
</Base>
