---
// Concept D: built directly from the research Page "What Boise Moms Want From a Childcare Website" (2026-10-23).
// C's grid + A's serif/warm palette/photo treatment. No JS. Every fact comes from existing site content;
// anything not confirmed is a clearly labeled placeholder with a TODO below.
import { Image } from 'astro:assets'
import Shell from '../../layouts/ConceptShell.astro'
import { reviews, NAP, LICENSE_NUMBER, LINKS } from '../../lib/concepts'
import { HOLIDAYS_CLOSED } from '../../lib/site'
import zoey from '../../assets/concepts/zoey-toddler-2.jpeg'
import cuddle from '../../assets/concepts/joyful-daycare-cuddle-moment.jpg'
import preschool from '../../assets/concepts/preschool-web_orig.jpg'
import afterSchool from '../../assets/concepts/after-school-pals.jpg'
import splash from '../../assets/concepts/summer-camp-splash-2-web_orig.jpg'
import toddlers from '../../assets/concepts/toddlers-web_orig.jpg'
import ninja from '../../assets/concepts/ninja-warrior-private-class-pic-1_orig.jpg'
import ropes from '../../assets/concepts/ropes-course-web.jpeg'
import bday from '../../assets/concepts/birthday-party-web.jpeg'
import openPlay from '../../assets/concepts/open-play-web_1.jpg'

// TODO(Duncan/Rhea): real availability per program. Until then every card shows the neutral "Ask about openings"
// chip in the slot where Open / Limited / Waitlist will go. Do NOT hard-code a status without staff data.
// TODO(Duncan): decide whether to show "from $X" tuition. Prices below are the lowest prices already published
// on the program pages (infant-toddler-care, preschool, after-school-care). Set SHOW_PRICES=false to swap to "Pricing on tour".
const SHOW_PRICES = true
const programs = [
  { name: 'Infant & Toddler', ages: '6 weeks – 3 years', hours: 'Mon–Fri · 7:30 am – 6 pm', fact: '1 teacher for every 4 babies', from: '$650/mo', fromNote: 'part time, 2 days', img: zoey, alt: 'A teacher hugging a smiling toddler', to: '/infant-toddler-care', tour: 'Infant & Toddler Care' },
  { name: 'Preschool', ages: 'Ages 3 – 6', hours: 'Morning class 9 am – 12 pm, or care 7:30 am – 6 pm', fact: '8:1 ratio · kindergarten readiness', from: '$355/mo', fromNote: 'morning class, 2 days', img: preschool, alt: 'A laughing preschooler in a red cap', to: '/preschool', tour: 'Preschool' },
  { name: 'Before & After School', ages: 'K – 6th grade', hours: 'From 7:30 am until school · pickup until 6 pm', fact: 'Transportation, snack, homework club', from: '$248/mo', fromNote: 'before school, 2 days', img: afterSchool, alt: 'Two school-age boys in silly glasses', to: '/after-school-care', tour: 'Before & After School Care' },
]
// TODO(Duncan/staff): star rating + review count. No verified Google rating exists in site content yet,
// so the hero shows a placeholder instead of a number.
const faq = [
  { q: 'Are you licensed? What is your license number?', a: `Yes. Our Idaho childcare license number is ${LICENSE_NUMBER}.` },
  { q: 'Are you an Idaho STARS provider?', a: 'Yes, Bodies in Motion is an Idaho STARS provider.' },
  { q: 'What are your staff-to-child ratios?', a: 'Our infant room has 1 teacher for every 4 babies. Preschool runs at an 8:1 ratio.' },
  { q: 'What are your hours?', a: 'Childcare runs Monday to Friday, 7:30 am to 6 pm. Before-school care starts at 7:30 am and we take children to school; after school we pick them up and care runs until 6 pm.' },
  { q: 'Are you open on holidays?', a: `We are closed on ${HOLIDAYS_CLOSED.join(', ')}, and close early on Halloween, Christmas Eve and New Year’s Eve.` },
  { q: 'Do you take kids to and from school?', a: 'Yes. Before and after school options include transportation. Ask us which Boise schools we serve.' },
  { q: 'Are meals included?', a: 'Full-time infant and toddler tuition includes daily snacks and meals. After school starts with snack time.' },
  { q: 'Are teachers background-checked?', a: 'Yes. Every teacher is interviewed for patience, background-checked and licensed. Infant classrooms have recorded surveillance.' },
  { q: 'How much is infant care?', a: 'Full-time infant and toddler care is $1626 a month. Part time is $975 (3 days) or $650 (2 days).' },
  { q: 'Do you have openings, or a waitlist?', a: 'Openings change through the year. Book a tour or join the waitlist and we’ll tell you what’s available for your child’s age.' },
  { q: 'Are you in Meridian?', a: `We have one location, at ${NAP.street} in Boise, and many of our families come from Meridian and Garden City.` },
]
// TODO(staff): confirm before these get answers: CPR certification, ICCP / state assistance, parent update app,
// illness policy, which schools we transport from, reply-time promise ("within 1 business day").
const unconfirmed = ['Are staff CPR certified?', 'Do you accept ICCP / state childcare assistance?', 'How do you update parents during the day?', 'What is your illness policy?']
const revs = reviews.slice(0, 3)
---
<Shell title="Concept D · Parent-first | Bodies in Motion" description="Design concept D for the Bodies in Motion homepage, built from parent research." fonts={['fraunces', 'inter']}>
<div class="d">
  <a class="sr-only" href="#tour">Skip to tour form</a>
  <header class="top">
    <a href="/" class="brand">Bodies in Motion</a>
    <nav aria-label="Main"><a href="#programs">Programs</a><a href="#safety">Safety</a><a href="#camps">Camps</a><a href="#faq">FAQ</a></nav>
    <a class="tel" href={NAP.phoneTel}>{NAP.phoneDisplay}</a>
    <a class="btn" href="#tour">Book a tour</a>
  </header>

  <main>
    <section class="hero wrap" aria-labelledby="h1">
      <div class="hero__copy">
        <p class="kicker">Boise childcare · one building, birth to big kid</p>
        <h1 id="h1">Licensed childcare, preschool <em>&amp; camps</em> in Boise.</h1>
        <ul class="facts" aria-label="Quick facts">
          <li><b>Ages</b>6 weeks – 6th grade</li>
          <li><b>Hours</b>Mon–Fri 7:30 am – 6 pm</li>
          <li><b>Where</b>{NAP.street}, Boise</li>
        </ul>
        <div class="ctas"><a class="btn btn--lg" href="#tour">Book a tour</a><a class="btn btn--ghost btn--lg" href="#programs">Check openings</a></div>
      </div>
      <figure class="hero__art">
        <Image src={cuddle} alt="A smiling teacher holding two babies" widths={[600, 900, 1200]} sizes="(max-width:900px) 100vw, 45vw" loading="eager" fetchpriority="high" />
      </figure>
      <ul class="trust" aria-label="Credentials">
        <li><span class="ic" aria-hidden="true">✓</span><span><b>Idaho STARS</b> provider</span></li>
        <li><span class="ic" aria-hidden="true">✓</span><span><b>License #{LICENSE_NUMBER}</b> {/* TODO(Duncan): link to the state license lookup once we have the exact URL */}<small>State of Idaho</small></span></li>
        <li><span class="ic" aria-hidden="true">✓</span><span><b>1:4 infants · 8:1 preschool</b> teacher ratios</span></li>
        <li class="ph"><span class="ic" aria-hidden="true">★</span><span><b>★ rating · # reviews</b><small>Placeholder: Google rating</small></span></li>
      </ul>
    </section>

    <section id="programs" class="wrap block" aria-labelledby="prog-h">
      <div class="head"><p class="kicker">Openings &amp; tuition</p><h2 id="prog-h">Find the right program</h2></div>
      <div class="grid3">
        {programs.map((p) => (
          <article class="card prog reveal">
            <Image src={p.img} alt={p.alt} widths={[420, 680]} sizes="(max-width:900px) 100vw, 33vw" />
            <div class="pbody">
              <p class="status" title="Placeholder until staff confirm real availability"><span class="sdot" aria-hidden="true"></span>Ask about openings</p>
              <h3>{p.name}</h3>
              <dl class="tags"><div><dt>Ages</dt><dd>{p.ages}</dd></div><div><dt>Hours</dt><dd>{p.hours}</dd></div><div><dt>Good to know</dt><dd>{p.fact}</dd></div>
                <div><dt>Tuition</dt><dd>{SHOW_PRICES ? <><b class="price">from {p.from}</b> <small>{p.fromNote}</small></> : 'Pricing shared on your tour'}</dd></div></dl>
              <div class="ctas ctas--sm"><a class="btn" href="#tour">Book a tour</a><a class="btn btn--ghost" href={p.to}>Details</a></div>
            </div>
          </article>
        ))}
      </div>
      <p class="note">Openings change month to month. <a href="#tour">Join the waitlist</a> and we’ll reach out when a spot opens for your child’s age.</p>
    </section>

    <section class="story" aria-labelledby="story-h">
      <div class="wrap story__in">
        <Image src={toddlers} alt="Toddlers playing together" widths={[600, 900]} sizes="(max-width:900px) 100vw, 45vw" class="story__img" />
        <div>
          <p class="kicker">One building, one drop-off</p>
          <h2 id="story-h">From their first year to their first summer camp.</h2>
          <p>Infant care, preschool, before &amp; after school, and school-break camps all happen under one roof at {NAP.street}. Siblings get dropped off at the same door, and the teachers your baby knows are down the hall when they’re ready for preschool.</p>
          <p>Locally owned by Duncan and Rachel Richardson, serving Boise families since 2011.</p>
        </div>
      </div>
    </section>

    <section id="safety" class="wrap block" aria-labelledby="safe-h">
      <div class="head"><p class="kicker">Safety &amp; staff</p><h2 id="safe-h">The things you’ll check first</h2></div>
      <ul class="grid4">
        <li class="card tile"><b>Licensed</b><p>Idaho childcare license #{LICENSE_NUMBER}, and an Idaho STARS provider.</p></li>
        <li class="card tile"><b>Low ratios</b><p>1 teacher for every 4 babies. 8:1 in preschool.</p></li>
        <li class="card tile"><b>Vetted teachers</b><p>Every teacher is interviewed for patience, background-checked and licensed.</p></li>
        <li class="card tile"><b>Recorded classrooms</b><p>Infant classrooms have recorded surveillance.</p></li>
      </ul>
      <p class="note ph-note">Placeholder: CPR certification, secure check-in and illness policy go here once staff confirm.</p>
    </section>

    <section class="reviews" aria-labelledby="rev-h">
      <div class="wrap">
        <div class="head head--light"><p class="kicker">From other parents</p><h2 id="rev-h">What families say</h2></div>
        <div class="grid3">
          {revs.map((r) => <figure class="rev reveal"><blockquote>“{r.quote}”</blockquote><figcaption>{r.name}{r.source && <small> · {r.source}</small>}</figcaption></figure>)}
        </div>
        <p class="more"><a href="/reviews">Read all reviews →</a></p>
      </div>
    </section>

    <div class="wrap block"><section id="camps" class="camps" aria-labelledby="camp-h">
      <Image src={splash} alt="Campers sitting on a wall in front of a sprinkler" widths={[640, 1100]} sizes="(max-width:900px) 100vw, 50vw" class="camps__img" />
      <div class="camps__copy">
        <p class="kicker">Camps &amp; school breaks</p>
        <h2 id="camp-h">Winter break and summer, covered.</h2>
        <p>Winter-break camps, summer camps and our summer Learn to Ride camp. Dates, prices and registration all live on Camps for Kids Idaho.</p>
        <div class="ctas"><a class="btn" href={LINKS.camps}>See camps &amp; register</a></div>
      </div>
    </section></div>

    <section class="wrap block" aria-labelledby="more-h">
      <div class="head"><p class="kicker">Also under our roof</p><h2 id="more-h">More to do here</h2></div>
      <div class="grid4 extras">
        {[[ninja, 'Ninja Warrior', '/ninja-warrior', 'A child on a ninja bar with a coach cheering'], [openPlay, 'Open Play', '/open-play', 'Kids on the indoor play structure'], [ropes, 'Ropes Course', '/ropes-course', 'A child on the high ropes course'], [bday, 'Birthday Parties', '/birthday-parties', 'Two girls smiling among balloons']].map(([img, t, to, alt]) => (
          <a class="card extra" href={to as string}><Image src={img as any} alt={alt as string} widths={[360, 560]} sizes="(max-width:900px) 50vw, 25vw" /><span>{t as string} →</span></a>
        ))}
      </div>
    </section>

    <section id="faq" class="wrap block faq" aria-labelledby="faq-h">
      <div class="head"><p class="kicker">Questions parents ask</p><h2 id="faq-h">Straight answers</h2></div>
      <div class="faq__list">
        {faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
        {unconfirmed.map((q) => <details class="ph"><summary><span>{q} <small class="pend">Answer pending</small></span></summary><p>Answer pending staff confirmation.</p></details>)}
      </div>
    </section>

    <section id="tour" class="tour" aria-labelledby="tour-h">
      <div class="wrap tour__in">
        <div class="tour__copy">
          <p class="kicker">See it in person</p>
          <h2 id="tour-h">Book a tour or join the waitlist.</h2>
          <p>Six quick fields. Rhea will reach out to set a time. {/* TODO(Rhea): confirm a reply-time promise before showing one */}</p>
          <p class="visit"><b>{NAP.street}</b><br />{NAP.city}, {NAP.state} {NAP.zip}<br /><a href={NAP.phoneTel}>{NAP.phoneDisplay}</a> · <a href={`mailto:${NAP.email}`}>{NAP.email}</a><br /><small>Serving Boise, Meridian &amp; Garden City families</small></p>
        </div>
        <form class="card form" method="post" action="/api/contact">
          <fieldset class="seg"><legend class="sr-only">Request type</legend>
            <label><input type="radio" name="program" value="Tour" checked /> <span>Book a tour</span></label>
            <label><input type="radio" name="program" value="Waitlist" /> <span>Join waitlist</span></label>
          </fieldset>
          <label>Your name <input name="name" required maxlength="120" autocomplete="name" /></label>
          <label>Phone <input name="phone" type="tel" required maxlength="40" autocomplete="tel" /></label>
          <label>Email <input name="email" type="email" required maxlength="200" autocomplete="email" /></label>
          <label>Child’s age or due date <input name="child_age" required maxlength="80" placeholder="e.g. 8 months, or due in March" /></label>
          <label>Program <select name="tour_program">{programs.map((p) => <option>{p.tour}</option>)}<option>Not sure yet</option></select></label>
          <label>Best time for a tour <select name="tour_time"><option>Weekday morning</option><option>Weekday midday</option><option>Weekday afternoon</option></select></label>
          <details class="optional"><summary>Add a start date or note (optional)</summary>
            <label>Desired start date <input name="start_date" type="date" /></label>
            <label>Note <textarea name="message" rows="3" maxlength="5000"></textarea></label>
          </details>
          <label class="hp" aria-hidden="true">Company <input name="company" tabindex="-1" autocomplete="off" /></label>
          <button class="btn btn--lg" type="submit">Send request</button>
        </form>
      </div>
    </section>
  </main>
  <footer class="foot wrap">© Bodies in Motion · {NAP.street}, {NAP.city}, {NAP.state} · License #{LICENSE_NUMBER} · Idaho STARS provider</footer>

  {/* TODO(Duncan): confirm (208) 381-0587 can receive texts before launch; otherwise drop the Text button. */}
  <nav class="mbar" aria-label="Quick actions"><a class="mb mb--main" href="#tour">Book a tour</a><a class="mb" href={NAP.phoneTel}>Call</a><a class="mb" href={`sms:${NAP.phoneE164}`}>Text</a></nav>
</div>
</Shell>
<style>
.d{--bg:#f7f2ea;--card:#fffdf9;--ink:#1f1b16;--mute:#5c5248;--acc:#a8461f;--sage:#3f6b57;--sage-bg:#e5efe8;--line:#e2d8c9;--r:24px;background:var(--bg);color:var(--ink);font:400 1.0625rem/1.6 Inter,system-ui,sans-serif;padding-bottom:0}
.d h1,.d h2,.d h3{font-family:Fraunces,Georgia,serif;font-weight:500;letter-spacing:-.02em;line-height:1.08}
.d em{font-style:italic;color:var(--acc)}
.wrap{max-width:1240px;margin:auto;padding-inline:clamp(16px,4vw,40px)}
.kicker{font-size:.78rem;letter-spacing:.14em;text-transform:uppercase;color:var(--acc);font-weight:700;margin-bottom:10px}
.top{position:sticky;top:0;z-index:5;display:flex;align-items:center;gap:28px;padding:14px clamp(16px,4vw,40px);background:color-mix(in srgb,var(--bg) 90%,transparent);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
.brand{font:600 1.3rem/1 Fraunces,serif;text-decoration:none;margin-right:auto}
.top nav{display:flex;gap:22px}.top nav a{text-decoration:none;color:var(--mute);font-size:.95rem}.top nav a:hover{color:var(--ink)}
.tel{font-weight:600;text-decoration:none}
.btn{white-space:nowrap;display:inline-flex;align-items:center;justify-content:center;padding:12px 22px;min-height:44px;border-radius:999px;background:var(--acc);color:#fff;font-weight:600;text-decoration:none;border:0;font-size:1rem;cursor:pointer;transition:transform .2s,background .2s}
.btn:hover{background:#8e3a19;transform:translateY(-1px)}
.btn--ghost{background:transparent;color:var(--ink);box-shadow:inset 0 0 0 1.5px var(--ink)}.btn--ghost:hover{background:var(--ink);color:var(--bg)}
.btn--lg{padding:15px 28px;font-size:1.05rem}
.ctas{display:flex;flex-wrap:wrap;gap:10px;margin-top:28px}.ctas--sm{margin-top:18px}
.card{background:var(--card);border:1px solid var(--line);border-radius:var(--r);overflow:hidden}
.hero{display:grid;grid-template-columns:1.05fr .95fr;gap:clamp(24px,4vw,56px);align-items:center;padding-top:clamp(28px,5vw,64px)}
.d h1{font-size:clamp(2.4rem,5.2vw,4.4rem);margin-bottom:24px}
.facts{list-style:none;display:flex;flex-wrap:wrap;gap:10px}
.facts li{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:10px 16px;font-size:.98rem}
.facts b{display:block;font-size:.72rem;letter-spacing:.1em;text-transform:uppercase;color:var(--mute)}
.hero__art{border-radius:32px 32px 32px 140px;overflow:hidden;aspect-ratio:4/4.2;box-shadow:0 30px 60px -30px rgba(80,40,10,.35)}
.hero__art img{width:100%;height:100%;object-fit:cover}
.trust{grid-column:1/-1;list-style:none;display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:8px}
.trust li{display:flex;gap:12px;align-items:center;background:var(--card);border:1px solid var(--line);border-radius:18px;padding:16px 18px;font-size:.95rem}
.trust small{display:block;color:var(--mute);font-size:.8rem}
.ic{flex:none;display:grid;place-items:center;width:32px;height:32px;border-radius:50%;background:var(--sage-bg);color:var(--sage);font-weight:700}
.ph{border-style:dashed!important;border-color:#b9a78f!important;background:repeating-linear-gradient(135deg,var(--card) 0 10px,#f4ece0 10px 20px)!important}
.block{margin-top:clamp(64px,9vw,112px)}
.head{margin-bottom:24px}.head h2{font-size:clamp(2rem,3.6vw,3rem)}
.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
.grid4{list-style:none;display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
.prog img{width:100%;aspect-ratio:16/11;object-fit:cover}
.pbody{padding:20px 22px 24px}.pbody h3{font-size:1.65rem;margin:10px 0 12px}
.status{display:inline-flex;align-items:center;gap:8px;padding:6px 12px;border-radius:999px;border:1.5px dashed var(--sage);color:var(--sage);background:var(--sage-bg);font-weight:600;font-size:.85rem}
.sdot{width:8px;height:8px;border-radius:50%;background:var(--sage)}
.tags{display:grid;gap:8px;font-size:.95rem}.tags div{display:grid;grid-template-columns:96px 1fr;gap:8px;border-top:1px solid var(--line);padding-top:8px}
.tags dt{color:var(--mute);font-size:.85rem}.price{font-weight:700;color:var(--ink)}.tags small{color:var(--mute)}
.note{margin-top:20px;color:var(--mute)}.note a{color:var(--acc);font-weight:600}
.ph-note{border:1.5px dashed #b9a78f;border-radius:14px;padding:10px 14px;display:inline-block}
.story{margin-top:clamp(64px,9vw,112px);background:#efe5d6;padding:clamp(48px,7vw,96px) 0}
.story__in{display:grid;grid-template-columns:.9fr 1.1fr;gap:clamp(24px,5vw,72px);align-items:center}
.story__img{border-radius:140px 28px 28px 28px;width:100%;aspect-ratio:5/4;object-fit:cover}
.story h2{font-size:clamp(2rem,3.6vw,3rem);margin-bottom:18px}.story p+p{margin-top:12px;color:var(--mute)}
.tile{padding:22px}.tile b{font:500 1.35rem/1.2 Fraunces,serif}.tile p{color:var(--mute);margin-top:6px}
.reviews{margin-top:clamp(64px,9vw,112px);background:var(--ink);color:var(--bg);padding:clamp(56px,8vw,100px) 0}
.head--light .kicker{color:#f0b391}
.rev{border-left:2px solid #f0b391;padding-left:20px}.rev blockquote{font:400 1.3rem/1.45 Fraunces,serif}.rev figcaption{margin-top:14px;font-weight:600}.rev small{opacity:.8;font-weight:400}
.more{margin-top:28px}.more a{color:#f0b391;font-weight:600}
.camps{display:grid;grid-template-columns:1fr 1fr;gap:0;background:var(--card);border:1px solid var(--line);border-radius:var(--r);overflow:hidden;padding:0}
.camps__img{width:100%;height:100%;object-fit:cover;min-height:340px}
.camps__copy{padding:clamp(28px,4vw,56px);align-self:center}.camps h2{font-size:clamp(1.9rem,3.2vw,2.6rem);margin-bottom:14px}.camps p{color:var(--mute)}
.extra{position:relative;text-decoration:none}.extra img{width:100%;aspect-ratio:4/3;object-fit:cover;transition:transform .4s}
.extra:hover img{transform:scale(1.04)}.extra span{display:block;padding:14px 18px;font-weight:600}
.faq__list{display:grid;grid-template-columns:1fr 1fr;gap:12px;align-items:start}
.faq details{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:16px 20px}
.faq summary{cursor:pointer;font-weight:600;list-style:none;display:flex;justify-content:space-between;gap:12px}
.faq summary::after{content:'+';color:var(--acc);font-size:1.3rem;line-height:1}.faq details[open] summary::after{content:'–'}
.faq details p{margin-top:10px;color:var(--mute)}
.tour{margin-top:clamp(64px,9vw,112px);background:#efe5d6;padding:clamp(56px,8vw,100px) 0}
.tour__in{display:grid;grid-template-columns:1fr 1fr;gap:clamp(24px,5vw,72px);align-items:start}
.tour h2{font-size:clamp(2rem,3.6vw,3rem);margin-bottom:14px}.tour__copy>p{color:var(--mute)}
.visit{margin-top:28px;line-height:1.8;color:var(--ink)!important}.visit a{color:var(--acc);font-weight:600}
.form{padding:clamp(22px,3vw,36px);display:grid;gap:14px}
.form label{display:grid;gap:6px;font-weight:600;font-size:.95rem}
.form input,.form select,.form textarea{font:inherit;font-weight:400;padding:12px 14px;min-height:48px;border:1.5px solid #b9a78f;border-radius:12px;background:#fff;color:var(--ink)}
.form input:focus-visible,.form select:focus-visible,.form textarea:focus-visible{outline:3px solid var(--acc);outline-offset:1px}
.seg{border:0;display:grid;grid-template-columns:1fr 1fr;gap:6px;background:var(--bg);padding:5px;border-radius:999px}
.seg label{display:block;text-align:center;cursor:pointer}.seg input{position:absolute;opacity:0}
.seg span{display:block;padding:10px;border-radius:999px}.seg input:checked+span{background:var(--ink);color:#fff}.seg input:focus-visible+span{outline:3px solid var(--acc)}
.optional summary{cursor:pointer;color:var(--acc);font-weight:600;margin-bottom:8px}.optional label{margin-top:10px}
.pend{display:inline-block;margin-left:6px;font-size:.72rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:#7a5a2e;background:#f1e3c8;border-radius:999px;padding:2px 8px;vertical-align:middle}
.hp{position:absolute;left:-9999px}
