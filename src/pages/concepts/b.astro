---
import { Image } from 'astro:assets'
import Shell from '../../layouts/ConceptShell.astro'
import { care, play, reviews, NAP, LICENSE_NUMBER, LINKS } from '../../lib/concepts'
import ninja from '../../assets/concepts/web-summer-camp-ninja-warrior_orig.jpg'
import salmon from '../../assets/concepts/ninja-salmon_orig.jpg'
import ropes from '../../assets/concepts/super-birthday-ropes-web_1_orig.jpg'
import bday from '../../assets/concepts/birthday-party-web.jpeg'
import slide from '../../assets/concepts/open-play-web_1.jpg'
import toddlers from '../../assets/concepts/toddlers-web_orig.jpg'
import preschool from '../../assets/concepts/preschool-web_orig.jpg'
import afterSchool from '../../assets/concepts/after-school-pals.jpg'
import camp from '../../assets/concepts/camps-web_orig.jpg'
const careImgs = [toddlers, preschool, afterSchool]
const careAlts = ['Two toddlers playing with a toy truck', 'A laughing preschooler in a red cap', 'Two school-age boys in silly glasses']
const colors = ['#ffd23f', '#ff6b4a', '#4cc9f0', '#b8f35a', '#c49bff', '#ffd23f', '#ff6b4a', '#4cc9f0']
const tiles = [
  { ...play[0], img: camp, alt: 'A camp counselor and kids giving thumbs up outdoors' },
  { ...play[1], img: salmon, alt: 'A child swinging across a ninja warrior obstacle' },
  { ...play[2], img: bday, alt: 'Two girls smiling among pink and gold balloons' },
  { ...play[3], img: slide, alt: 'Kids racing down orange and blue indoor slides' },
  { ...play[4], img: ropes, alt: 'Kids in helmets on the high ropes course' },
]
---
<Shell title="Concept B · Bold & playful | Bodies in Motion" description="Design concept B for the Bodies in Motion homepage: bold, playful, energetic." fonts={['bricolage','inter']}>
<div class="b">
  <header class="top">
    <a href="/" class="brand">BIM<span>●</span></a>
    <nav aria-label="Main"><a href="/infant-toddler-care">Childcare</a><a href="/camps">Camps</a><a href="/ninja-warrior">Ninja</a><a href="/birthday-parties">Parties</a><a href="/open-play">Open Play</a></nav>
    <a class="pill pill--y" href={LINKS.calendly30}>Book a tour</a>
  </header>
  <main>
    <section class="hero">
      <h1><span class="l1">Boise’s home</span> <span class="l2">for kids who</span> <span class="l3">never <em>stop</em></span> <span class="l4">moving.</span></h1>
      <div class="hero__pics" aria-hidden="false">
        <Image class="p1" src={ninja} alt="Campers cheering on a friend hanging from a ninja warrior bar" widths={[480, 800]} sizes="(max-width:900px) 70vw, 34vw" loading="eager" fetchpriority="high" />
        <Image class="p2" src={ropes} alt="Kids in helmets smiling on the ropes course" widths={[320, 560]} sizes="(max-width:900px) 45vw, 20vw" loading="eager" />
        <span class="sticker s1">Since 2011</span>
        <span class="sticker s2">Idaho STARS provider</span>
      </div>
      <div class="hero__foot">
        <p>Childcare, preschool and after-school care, plus ninja, ropes, camps and parties. All under one roof at 729 W. Diamond St.</p>
        <div class="ctas"><a class="pill pill--y pill--lg" href="/infant-toddler-care">Childcare &amp; preschool</a><a class="pill pill--o pill--lg" href="/camps">Find a camp</a></div>
      </div>
    </section>

    <div class="marquee" aria-hidden="true"><div>{[0,1].map(() => <span>Ninja Warrior ✦ Camps ✦ Preschool ✦ Ropes Course ✦ Birthday Parties ✦ Open Play ✦ After School ✦ Pickleball ✦ </span>)}</div></div>

    <section class="care" aria-labelledby="care-h">
      <h2 id="care-h">Care that keeps up.</h2>
      <p class="sub">Licensed childcare #{LICENSE_NUMBER}. Small ratios. A building made for moving.</p>
      <div class="care__grid">
        {care.map((c, i) => (
          <article class="ccard reveal" style={`--c:${colors[i * 2 + 1]}`}>
            <Image src={careImgs[i]} alt={careAlts[i]} widths={[400, 640]} sizes="(max-width:900px) 90vw, 30vw" />
            <div class="ccard__body">
              <span class="tag">{c.ages}</span>
              <h3>{c.name}</h3>
              <p>{c.fact}</p>
              <div class="ccard__cta"><a href={c.tour}>Book a tour</a><a href={c.to} aria-label={`More about ${c.name}`}>→</a></div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="playzone" aria-labelledby="play-h">
      <h2 id="play-h">After school, weekends &amp; every&nbsp;birthday.</h2>
      <div class="tiles">
        {tiles.map((t, i) => (
          <a class={`tile tile--${i}`} href={t.to} style={`--c:${colors[i]}`}>
            <Image src={t.img} alt={t.alt} widths={[400, 720]} sizes="(max-width:900px) 90vw, 33vw" />
            <span class="tile__label"><b>{t.name}</b><small>{t.blurb}</small></span>
          </a>
        ))}
        <div class="tile tile--more">
          <b>Also here</b>
          <ul>{play.slice(5).map((p) => <li><a href={p.to}>{p.name} →</a></li>)}</ul>
        </div>
      </div>
    </section>

    <section class="love" aria-labelledby="love-h">
      <h2 id="love-h">Parents say it best</h2>
      <div class="love__row">
        {reviews.map((r, i) => <figure class="bubble reveal" style={`--c:${colors[i + 1]}`}><blockquote>“{r.quote}”</blockquote><figcaption>{r.name}{r.source && ` · ${r.source}`}</figcaption></figure>)}
      </div>
    </section>

    <section class="cta">
      <h2>Come play.<br />Come see.</h2>
      <div class="ctas"><a class="pill pill--y pill--lg" href={LINKS.calendly30}>Book a tour</a><a class="pill pill--w pill--lg" href="/waiver">Sign a waiver</a></div>
      <p>{NAP.street}, {NAP.city} · <a href={NAP.phoneTel}>{NAP.phoneDisplay}</a> · <a href={`mailto:${NAP.email}`}>{NAP.email}</a></p>
    </section>
  </main>
  <footer class="foot">© Bodies in Motion · Idaho childcare license #{LICENSE_NUMBER} · Idaho STARS provider</footer>
</div>
</Shell>
<style>
.b{--ink:#14123a;--y:#ffd23f;--o:#ff6b4a;--bl:#4cc9f0;--cream:#fffaf0;background:var(--cream);color:var(--ink);font:500 1.05rem/1.55 Inter,system-ui,sans-serif;overflow-x:clip}
.b h1,.b h2,.b h3,.brand,.tile b,.sticker,.marquee{font-family:'Bricolage Grotesque',system-ui,sans-serif;letter-spacing:-.035em}
.top{display:flex;align-items:center;gap:28px;padding:18px clamp(16px,4vw,48px)}
.brand{font-size:2rem;font-weight:800;text-decoration:none;margin-right:auto}.brand span{color:var(--o);font-size:1rem;vertical-align:super}
.top nav{display:flex;gap:6px}.top nav a{text-decoration:none;font-weight:600;padding:8px 14px;border-radius:999px}.top nav a:hover{background:var(--ink);color:#fff}
.pill{display:inline-flex;align-items:center;justify-content:center;font-weight:700;text-decoration:none;border-radius:999px;padding:11px 20px;border:2.5px solid var(--ink);box-shadow:3px 3px 0 var(--ink);transition:transform .15s,box-shadow .15s}
.pill:hover{transform:translate(-2px,-2px);box-shadow:5px 5px 0 var(--ink)}
.pill--y{background:var(--y)}.pill--o{background:var(--o)}.pill--w{background:#fff}.pill--lg{padding:16px 28px;font-size:1.1rem}
.hero{display:grid;grid-template-columns:1.15fr .85fr;grid-template-areas:"h p" "f p";gap:24px 48px;padding:clamp(24px,4vw,56px) clamp(16px,4vw,48px) 64px;max-width:1480px;margin:auto}
.hero h1{grid-area:h;font-size:clamp(3.2rem,8.4vw,8.4rem);line-height:.9;font-weight:800}
.hero h1 span{display:block}.hero h1 .l2{color:#d43f17}.hero h1 em{font-style:normal;background:var(--y);padding:0 .12em;border-radius:.2em;display:inline-block;rotate:-3deg}
.hero__pics{grid-area:p;position:relative;min-height:520px}
.p1{position:absolute;top:0;right:0;width:88%;aspect-ratio:4/5;object-fit:cover;border-radius:40px;border:3px solid var(--ink);rotate:2deg}
.p2{position:absolute;left:0;bottom:0;width:54%;aspect-ratio:1;object-fit:cover;border-radius:50%;border:3px solid var(--ink);background:var(--bl)}
.sticker{position:absolute;font-weight:800;border:2.5px solid var(--ink);border-radius:999px;padding:10px 18px;font-size:1.1rem;box-shadow:3px 3px 0 var(--ink)}
.s1{top:6%;left:0;background:var(--bl);rotate:-8deg}.s2{bottom:10%;right:-2%;background:var(--y);rotate:6deg}
.hero__foot{grid-area:f;max-width:560px}.hero__foot p{font-size:1.2rem}
.ctas{display:flex;flex-wrap:wrap;gap:14px;margin-top:24px}
.marquee{background:var(--ink);color:var(--y);font-size:clamp(1.6rem,3vw,2.4rem);font-weight:800;padding:18px 0;white-space:nowrap;overflow:hidden;rotate:-1.5deg;margin:20px -10px}
.marquee div{display:inline-flex;animation:mq 30s linear infinite}
@keyframes mq{to{translate:-50% 0}}
.care,.playzone,.love{max-width:1400px;margin:auto;padding:clamp(64px,8vw,112px) clamp(16px,4vw,48px) 0}
.b h2{font-size:clamp(2.6rem,6vw,5.2rem);font-weight:800;line-height:.95;max-width:14ch}
.sub{font-size:1.2rem;margin-top:16px}
.care__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;margin-top:44px}
.ccard{background:var(--c);border:3px solid var(--ink);border-radius:32px;overflow:hidden;display:flex;flex-direction:column;box-shadow:6px 6px 0 var(--ink)}
.ccard img{aspect-ratio:4/3;object-fit:cover;width:100%;border-bottom:3px solid var(--ink)}
.ccard__body{padding:24px;display:flex;flex-direction:column;gap:8px;flex:1}
.tag{align-self:flex-start;background:#fff;border:2px solid var(--ink);border-radius:999px;padding:3px 12px;font-size:.85rem;font-weight:700}
.ccard h3{font-size:2rem;line-height:1;font-weight:800}
.ccard__cta{margin-top:auto;padding-top:12px;display:flex;gap:10px}
.ccard__cta a{background:var(--ink);color:#fff;text-decoration:none;font-weight:700;border-radius:999px;padding:12px 20px}
.ccard__cta a:last-child{padding:12px 16px}
.tiles{display:grid;grid-template-columns:repeat(4,1fr);grid-auto-rows:260px;gap:18px;margin-top:44px}
.tile{position:relative;border-radius:32px;overflow:hidden;border:3px solid var(--ink);text-decoration:none;background:var(--c)}
.tile img{width:100%;height:100%;object-fit:cover;transition:scale .5s}
.tile:hover img{scale:1.06}
.tile--0{grid-column:span 2;grid-row:span 2}.tile--3,.tile--4,.tile--more{grid-column:span 2}
.tile__label{position:absolute;left:12px;right:12px;bottom:12px;background:var(--c);border:2.5px solid var(--ink);border-radius:20px;padding:12px 16px;display:flex;flex-direction:column}
.tile b{font-size:1.5rem;line-height:1.05}.tile small{font-size:.88rem;font-weight:600}
.tile--more{background:var(--ink);color:#fff;padding:28px 32px;display:flex;flex-direction:column;justify-content:space-between}.tile--more ul{grid-template-columns:1fr 1fr}
.tile--more b{font-size:2rem;color:var(--y)}.tile--more ul{list-style:none;display:grid;gap:8px}.tile--more a{text-decoration:none;font-weight:700;font-size:1.1rem}
.love__row{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;margin-top:40px}
.bubble{background:#fff;border:3px solid var(--ink);border-radius:28px 28px 28px 6px;padding:24px;box-shadow:5px 5px 0 var(--c)}
.bubble blockquote{font-size:1.05rem;font-weight:600}.bubble figcaption{margin-top:14px;font-size:.85rem;font-weight:700;opacity:.8}
.cta{margin:clamp(64px,8vw,112px) clamp(12px,3vw,40px) 0;background:var(--o);border:3px solid var(--ink);border-radius:40px;padding:clamp(48px,7vw,96px) clamp(24px,5vw,80px)}
.cta h2{font-size:clamp(3rem,9vw,8rem)}.cta p{margin-top:28px;font-weight:600}
.foot{text-align:center;padding:40px 16px 90px;font-size:.88rem;font-weight:600}
@media (max-width:1000px){.love__row{grid-template-columns:1fr 1fr}.tiles{grid-template-columns:1fr 1fr}}
@media (max-width:900px){.top nav{display:none}.hero{grid-template-columns:1fr;grid-template-areas:"h" "p" "f"}.hero__pics{min-height:0;aspect-ratio:1/1.05}.care__grid{grid-template-columns:1fr}}
@media (max-width:600px){.love__row,.tiles{grid-template-columns:1fr}.tiles{grid-auto-rows:240px}.tile--0,.tile--3,.tile--4,.tile--more{grid-column:auto;grid-row:auto}.tile--more{min-height:240px}}
@media (prefers-reduced-motion:no-preference){@supports (animation-timeline:view()){
 .reveal{animation:pop linear both;animation-timeline:view();animation-range:entry 0% entry 55%}
 @keyframes pop{from{opacity:0;scale:.92;rotate:-2deg}to{opacity:1;scale:1;rotate:0deg}}
}}
@media (prefers-reduced-motion:reduce){.marquee div{animation:none}}
</style>
