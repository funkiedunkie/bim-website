---
import { Image } from 'astro:assets'
import Shell from '../../layouts/ConceptShell.astro'
import { care, play, reviews, NAP, LICENSE_NUMBER, LINKS } from '../../lib/concepts'
import cuddle from '../../assets/concepts/joyful-daycare-cuddle-moment.jpg'
import zoey from '../../assets/concepts/zoey-toddler-2.jpeg'
import preschool from '../../assets/concepts/preschool-web_orig.jpg'
import afterSchool from '../../assets/concepts/after-school-pals.jpg'
import ninja from '../../assets/concepts/ninja-warrior-private-class-pic-1_orig.jpg'
import splash from '../../assets/concepts/summer-camp-splash-2-web_orig.jpg'
import bday from '../../assets/concepts/birthday-party-web.jpeg'
const careImgs = [zoey, preschool, afterSchool]
const careAlts = ['A teacher hugging a smiling toddler', 'A laughing preschooler in a red cap', 'Two school-age boys in silly glasses']
const icons = ['◐', '✦', '◆', '●', '▲', '■', '◑', '★']
---
<Shell title="Concept C · Modern bento | Bodies in Motion" description="Design concept C for the Bodies in Motion homepage: clean, app-like bento layout." fonts={['inter']}>
<div class="c">
  <header class="top">
    <a href="/" class="brand"><span class="logo" aria-hidden="true"></span>Bodies in Motion</a>
    <nav aria-label="Main"><a href="/infant-toddler-care">Childcare</a><a href="/camps">Camps</a><a href="/birthday-parties">Parties</a><a href="/open-play">Open Play</a><a href="/hours">Hours</a></nav>
    <a class="btn btn--dark" href={LINKS.calendly30}>Book a tour</a>
  </header>
  <main class="wrap">
    <section class="bento hero-bento" aria-label="Overview">
      <div class="card card--hero">
        <p class="chip"><span class="dot"></span>729 W. Diamond St · Boise, ID</p>
        <h1>Childcare, preschool &amp; play. <span>One place. One drop-off.</span></h1>
        <p class="lede">Infant &amp; toddler care, preschool and before &amp; after school care, with camps, ninja, ropes and parties under the same roof.</p>
        <div class="ctas"><a class="btn btn--brand" href={LINKS.calendly30}>Book a tour</a><a class="btn" href="/infant-toddler-care">See programs</a></div>
      </div>
      <div class="card card--photo"><Image src={cuddle} alt="A smiling teacher holding two babies" widths={[480, 720]} sizes="(max-width:900px) 100vw, 33vw" loading="eager" fetchpriority="high" /></div>
      <div class="card card--stat card--brand"><div><b>1:4</b><span>Infant room</span></div><div><b>8:1</b><span>Preschool</span></div><p class="label">Teacher ratios</p></div>
      <div class="card card--trust"><p class="label">Licensed &amp; rated</p><ul><li><span>✓</span> Idaho STARS provider</li><li><span>✓</span> License #{LICENSE_NUMBER}</li><li><span>✓</span> Serving Boise since 2011</li></ul></div>
    </section>

    <section aria-labelledby="care-h" class="block">
      <div class="head"><h2 id="care-h">Care &amp; learning</h2><a href="/after-school-care">All childcare →</a></div>
      <div class="bento care">
        {care.map((c, i) => (
          <article class="card card--prog reveal">
            <Image src={careImgs[i]} alt={careAlts[i]} widths={[400, 640]} sizes="(max-width:900px) 100vw, 33vw" />
            <div class="pbody">
              <p class="label">{c.ages}</p>
              <h3>{c.name}</h3>
              <p>{c.fact}</p>
              <div class="ctas ctas--sm"><a class="btn btn--dark" href={c.tour}>Book a tour</a><a class="btn" href={c.to}>Details</a></div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section aria-labelledby="play-h" class="block">
      <div class="head"><h2 id="play-h">Play, camps &amp; parties</h2><a href="/camps">Camp schedule →</a></div>
      <div class="bento play">
        <a class="card card--img big reveal" href="/camps"><Image src={splash} alt="Campers sitting on a wall in front of a sprinkler" widths={[640, 1100]} sizes="(max-width:900px) 100vw, 50vw" /><span class="cap"><b>Camps</b>{play[0].blurb}</span></a>
        <a class="card card--img reveal" href="/ninja-warrior"><Image src={ninja} alt="A child hanging from a ninja bar with a coach cheering" widths={[400, 640]} sizes="(max-width:900px) 100vw, 25vw" /><span class="cap"><b>Ninja Warrior</b>{play[1].blurb}</span></a>
        <a class="card card--img reveal" href="/birthday-parties"><Image src={bday} alt="Two girls smiling among balloons" widths={[400, 640]} sizes="(max-width:900px) 100vw, 25vw" /><span class="cap"><b>Birthday Parties</b>{play[2].blurb}</span></a>
        <ul class="card card--list reveal">
          {play.slice(3).map((p, i) => <li><a href={p.to}><span class="ic" aria-hidden="true">{icons[i]}</span><span><b>{p.name}</b><small>{p.blurb}</small></span><span aria-hidden="true">›</span></a></li>)}
        </ul>
      </div>
    </section>

    <section aria-labelledby="rev-h" class="block">
      <div class="head"><h2 id="rev-h">What parents say</h2><a href="/reviews">All reviews →</a></div>
      <div class="bento revs">
        {reviews.map((r) => <figure class="card card--rev reveal"><blockquote>“{r.quote}”</blockquote><figcaption><span class="av" aria-hidden="true">{r.name[0]}</span>{r.name}{r.source && <small>{r.source}</small>}</figcaption></figure>)}
      </div>
    </section>

    <section class="bento final block" aria-labelledby="final-h">
      <div class="card card--cta"><h2 id="final-h">See it in person.</h2><p>Book a tour online or call us. We’ll walk you through the rooms and answer every question.</p><div class="ctas"><a class="btn btn--light" href={LINKS.calendly30}>Book a tour</a><a class="btn btn--outline" href={NAP.phoneTel}>{NAP.phoneDisplay}</a></div></div>
      <div class="card card--map"><p class="label">Visit</p><b>{NAP.street}</b><span>{NAP.city}, {NAP.state} {NAP.zip}</span><a href={`mailto:${NAP.email}`}>{NAP.email}</a><a href="/contact">Contact form →</a></div>
    </section>
  </main>
  <footer class="foot">© Bodies in Motion · Idaho childcare license #{LICENSE_NUMBER} · Idaho STARS provider</footer>
</div>
</Shell>
<style>
.c{--bg:#f2f3f5;--card:#fff;--ink:#0e1116;--mute:#555d6b;--brand:#2f5bea;--r:28px;background:var(--bg);color:var(--ink);font:400 1rem/1.55 Inter,system-ui,sans-serif;font-feature-settings:'ss01','cv11'}
.c h1,.c h2,.c h3{letter-spacing:-.035em;line-height:1.02;font-weight:700}
.top{position:sticky;top:10px;z-index:5;display:flex;align-items:center;gap:24px;margin:10px auto 0;max-width:1360px;width:calc(100% - 20px);padding:10px 10px 10px 20px;background:rgba(255,255,255,.8);backdrop-filter:blur(14px);border-radius:999px;box-shadow:0 1px 0 rgba(0,0,0,.04),0 8px 24px rgba(0,0,0,.05)}
.brand{display:flex;align-items:center;gap:10px;font-weight:700;text-decoration:none;margin-right:auto;letter-spacing:-.02em}
.logo{width:22px;height:22px;border-radius:7px;background:conic-gradient(from 200deg,#2f5bea,#22c55e,#f59e0b,#ef4444,#2f5bea)}
.top nav{display:flex;gap:4px}.top nav a{text-decoration:none;color:var(--mute);font-weight:500;font-size:.94rem;padding:8px 14px;border-radius:999px}.top nav a:hover{background:var(--bg);color:var(--ink)}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:12px 20px;border-radius:999px;font-weight:600;text-decoration:none;background:var(--bg);color:var(--ink);transition:transform .15s,filter .15s;font-size:.95rem}
.btn:hover{transform:translateY(-1px);filter:brightness(.96)}
.btn--dark{background:var(--ink);color:#fff}.btn--brand{background:var(--brand);color:#fff}.btn--light{background:#fff;color:var(--ink)}.btn--outline{background:transparent;color:#fff;box-shadow:inset 0 0 0 1.5px rgba(255,255,255,.6)}
.wrap{max-width:1360px;margin:auto;padding:20px 10px}
.bento{display:grid;gap:12px}
.card{background:var(--card);border-radius:var(--r);overflow:hidden;position:relative}
.label{font-size:.78rem;text-transform:uppercase;letter-spacing:.08em;color:var(--mute);font-weight:600}
.hero-bento{grid-template-columns:repeat(12,1fr);grid-template-rows:auto auto;min-height:640px}
.card--hero{grid-column:span 7;grid-row:span 2;padding:clamp(28px,4vw,56px);display:flex;flex-direction:column;justify-content:flex-end;background:radial-gradient(120% 90% at 100% 0%,#dfe7ff 0,transparent 55%),#fff}
.chip{align-self:flex-start;display:inline-flex;align-items:center;gap:8px;background:var(--bg);border-radius:999px;padding:6px 14px;font-size:.85rem;font-weight:600;margin-bottom:auto}
.dot{width:8px;height:8px;border-radius:50%;background:#16a34a;box-shadow:0 0 0 4px #16a34a33}
.c h1{font-size:clamp(2.6rem,5.6vw,5.2rem);margin:48px 0 20px}.c h1 span{color:var(--mute);display:block}
.lede{font-size:1.15rem;color:var(--mute);max-width:44ch}
.ctas{display:flex;flex-wrap:wrap;gap:10px;margin-top:28px}.ctas--sm{margin-top:16px}
.card--photo{grid-column:span 5}.card--photo img{width:100%;height:100%;object-fit:cover;min-height:320px}
.card--stat{grid-column:span 2;padding:22px;display:grid;grid-template-columns:1fr 1fr;gap:12px;align-content:space-between;min-height:150px}
.card--stat b{display:block;font-size:3rem;letter-spacing:-.05em;line-height:1}.card--stat span{font-weight:500}.card--stat .label{grid-column:span 2;color:#dbe4ff}
.card--brand{background:var(--brand);color:#fff}.card--brand span{color:#e6ecff}
.card--trust{grid-column:span 3;padding:22px}.card--trust ul{list-style:none;margin-top:12px;display:grid;gap:8px;font-weight:600}.card--trust li span{display:inline-grid;place-items:center;width:22px;height:22px;border-radius:50%;background:#dcfce7;color:#166534;font-size:.75rem;margin-right:6px}
.block{margin-top:56px}
.head{display:flex;justify-content:space-between;align-items:end;padding:0 8px 16px}.head h2{font-size:clamp(1.8rem,3.4vw,2.8rem)}.head a{font-weight:600;color:var(--brand);text-decoration:none}
.care{grid-template-columns:repeat(3,1fr)}
.card--prog img{width:100%;aspect-ratio:16/10;object-fit:cover}.pbody{padding:22px 24px 26px}.pbody h3{font-size:1.6rem;margin:6px 0}.pbody p:not(.label){color:var(--mute)}
.play{grid-template-columns:repeat(4,1fr);grid-auto-rows:240px}
.card--img img{width:100%;height:100%;object-fit:cover;transition:scale .5s}.card--img:hover img{scale:1.05}
.big{grid-column:span 2;grid-row:span 2}
.cap{position:absolute;left:10px;bottom:10px;right:10px;background:rgba(255,255,255,.9);backdrop-filter:blur(10px);border-radius:18px;padding:12px 16px;display:flex;flex-direction:column;font-size:.88rem;color:var(--mute)}
.cap b{color:var(--ink);font-size:1.1rem}
.card--list{grid-column:span 2;grid-row:span 1;list-style:none;padding:8px;display:grid;grid-template-columns:1fr 1fr}
.card--list a{display:flex;align-items:center;gap:12px;padding:12px;border-radius:18px;text-decoration:none;height:100%}.card--list a:hover{background:var(--bg)}
.card--list b{display:block;font-size:.98rem}.card--list small{color:var(--mute);font-size:.8rem;line-height:1.3;display:block}
.ic{flex:none;display:grid;place-items:center;width:38px;height:38px;border-radius:12px;background:#eef2ff;color:var(--brand)}
.card--list a>span:last-child{margin-left:auto;color:var(--mute)}
.revs{grid-template-columns:repeat(4,1fr)}
.card--rev{padding:26px;display:flex;flex-direction:column;justify-content:space-between;gap:20px}.card--rev blockquote{font-size:1.05rem;font-weight:500;letter-spacing:-.01em}
.card--rev figcaption{display:flex;align-items:center;gap:10px;font-weight:600;font-size:.92rem}.card--rev small{color:var(--mute);font-weight:500;margin-left:auto}
.av{display:grid;place-items:center;width:34px;height:34px;border-radius:50%;background:var(--bg);font-weight:700}
.final{grid-template-columns:2fr 1fr}
.card--cta{background:var(--ink);color:#fff;padding:clamp(32px,5vw,64px)}.card--cta h2{font-size:clamp(2.4rem,5vw,4.4rem)}.card--cta p{color:#c2c7d0;margin-top:12px;max-width:44ch}
.card--map{padding:28px;display:flex;flex-direction:column;gap:4px}.card--map b{font-size:1.4rem;margin-top:10px}.card--map a{color:var(--brand);font-weight:600;margin-top:8px}
.foot{text-align:center;color:var(--mute);font-size:.85rem;padding:32px 10px 90px}
@media (max-width:1100px){.revs{grid-template-columns:1fr 1fr}.card--trust{grid-column:span 6}.card--stat{grid-column:span 6}.card--hero{grid-column:span 12;grid-row:auto}.card--photo{grid-column:span 12}}
@media (max-width:900px){.top nav{display:none}.care,.final{grid-template-columns:1fr}.play{grid-template-columns:1fr 1fr}.card--list{grid-column:span 2;grid-row:auto}}
@media (max-width:600px){.hero-bento{grid-template-columns:1fr 1fr;min-height:0}.card--hero,.card--photo,.card--trust{grid-column:span 2}.card--stat{grid-column:span 2}.card--photo img{aspect-ratio:4/3;min-height:0}.play,.revs{grid-template-columns:1fr}.big,.card--list{grid-column:auto;grid-row:auto}.card--list{grid-template-columns:1fr}.c h1{margin-top:32px}}
@media (prefers-reduced-motion:no-preference){@supports (animation-timeline:view()){
 .reveal{animation:fade linear both;animation-timeline:view();animation-range:entry 0% entry 50%}
 @keyframes fade{from{opacity:0;translate:0 24px;scale:.98}to{opacity:1;translate:0 0;scale:1}}
}}
</style>
