---
// Indexed listing of the migrated blog posts, newest first. Cards, sitemap entries and
// JSON-LD are all derived from the `blog` content collection.
import { getCollection } from 'astro:content'
import Base from '../layouts/Base.astro'
import { NAP, SITE_URL, breadcrumbSchema } from '../lib/site'
import { isoDate, postPath, publisher, shortDate } from '../lib/blog'

const title = 'Kids Activity & Family Blog | Bodies in Motion Boise'
const description =
  'Articles from Bodies in Motion in Boise, ID: choosing infant care, preschool, after-school care and camps, plus birthday party, open play and team building ideas.'

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())

const jsonLd = [
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Blog', path: '/blog' },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': ['CollectionPage', 'Blog'],
    '@id': `${SITE_URL}/blog#blog`,
    url: `${SITE_URL}/blog`,
    name: `${NAP.name} Blog`,
    description,
    inLanguage: 'en-US',
    publisher,
    blogPost: posts.map((p) => ({
      '@type': 'BlogPosting',
      headline: p.data.title,
      url: SITE_URL + postPath(p.id),
      datePublished: isoDate(p.data.pubDate),
      dateModified: isoDate(p.data.updatedDate),
    })),
  },
]
---

<Base title={title} description={description} path="/blog" jsonLd={jsonLd}>
  <header class="page-hero">
    <div class="page-hero__inner">
      <p class="page-hero__eyebrow">Empowerment journal</p>
      <h1>Bodies in Motion Blog</h1>
      <p class="page-hero__lead">
        Practical articles for Boise families on keeping kids active and choosing care, camps, parties and activities.
      </p>
    </div>
  </header>

  <section class="section">
    <div class="section__inner">
      <ul class="post-grid">
        {posts.map((post) => (
          <li class="post-card">
            <h2 class="post-card__title"><a href={postPath(post.id)}>{post.data.title}</a></h2>
            <p class="post-card__date">
              <time datetime={isoDate(post.data.pubDate)}>{shortDate(post.data.pubDate)}</time>
            </p>
            <p class="post-card__desc">{post.data.description}</p>
            <a class="post-card__more" href={postPath(post.id)} aria-label={`Read: ${post.data.title}`}>Read article →</a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>
