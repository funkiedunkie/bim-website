---
import Stub from '../layouts/Stub.astro'
import { NAP } from '../lib/site'
import ContactForm from '../components/ContactForm.astro'
---

<Stub
  title="Contact Bodies in Motion | Boise, ID"
  description="Contact Bodies in Motion at 729 W. Diamond St, Boise, ID 83705, near the Fred Meyer on Federal Way. Call (208) 381-0587."
  path="/contact"
  h1="Contact Bodies in Motion"
  eyebrow="We’re ready to ignite activity & empowerment"
  showLocation
>
  <p>
    {NAP.name}, {NAP.street}, {NAP.city}, {NAP.state} {NAP.zip} (near the Fred Meyer on Federal Way). Main line:
    <a href={NAP.phoneTel}>{NAP.phoneDisplay}</a>. No Pickup Hotline: <a href={NAP.phoneTel}>{NAP.phoneDisplay}</a>
    Ext. 5.
  </p>
  <p>Email: <a href={`mailto:${NAP.email}`}>{NAP.email}</a></p>
  <ContactForm />
</Stub>
